# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/palladium?schema=public"
# 32+ random characters. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Public site URL (used in emails, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Email (optional). Without SMTP_HOST, emails are written to the notifications table and logged to the console.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="<your Resend API key>"
MAIL_FROM="Palladium <orders@palladiumpickleball.com>"
# Shared secret for POST /api/cron/outbox (send queued emails)
CRON_SECRET="change-me"
# Where uploaded product images are saved. Must be a persistent disk. For serverless hosting replace lib/storage.ts with S3/R2.
UPLOAD_DIR="./uploads"
# First super admin created by the seed script
SEED_ADMIN_EMAIL="admin@palladium.ph"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Image storage on serverless hosts (Vercel): Supabase Storage. Create a PUBLIC bucket (default name "palladium").
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="palladium"

# QR Ph via PayMongo (https://dashboard.paymongo.com -> Developers). Use sk_test_/pk_test_ keys first, then sk_live_/pk_live_.
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
# Webhook signing secret (starts with whsk_) shown after you create the webhook for https://YOUR-DOMAIN/api/payments/webhook
PAYMONGO_WEBHOOK_SECRET=""

# --- $PALLADIUM payments (Robinhood Chain) ---
# Wallet connection in the header works with no settings at all (MetaMask or any EVM wallet; Robinhood Chain testnet by default).
# Real payments switch on only when ALL of these are set:
TOKEN_NETWORK="testnet"                 # testnet | mainnet (presets in src/lib/chain-config.ts)
TOKEN_CONTRACT_ADDRESS=""               # the deployed $PALLADIUM ERC-20 contract
TOKEN_DECIMALS="18"
PALLADIUM_PAYMENT_WALLET_ADDRESS=""     # Palladium's receiving wallet; customers transfer tokens here
TOKEN_CHECKOUT_ENABLED=""               # true to offer "Pay with $PALLADIUM" at checkout
TOKEN_PRICE_SOURCE=""                   # manual (a reviewed fixed PHP rate) until a market price source exists
TOKEN_MANUAL_PRICE_PHP=""               # PHP per 1 token, e.g. 2.00
TOKEN_MANUAL_PRICE_REVIEWED=""          # yes, once the rate was approved
# Optional:
TOKEN_RPC_URL=""                        # dedicated JSON-RPC endpoint(s), comma-separated, tried in order; the chain's public RPC (rate-limited) is always the last fallback. Each is checked to be on the right chain first.
TOKEN_CONFIRMATIONS="3"                 # blocks that must follow a payment before the order is marked paid
TOKEN_DEPLOY_BLOCK=""                   # optional: block the token was deployed in, so /wallet activity scans the whole history (otherwise about the last 5 months)
TOKEN_QUOTE_TTL_SECONDS="300"           # how long an indicative checkout quote lasts (an order's locked amount lasts 15 minutes)
# DEMO MODE: simulated wallet and payment, no blockchain. Ignored on the production deployment and whenever real payments are configured.
PALLADIUM_DEMO_MODE=""
